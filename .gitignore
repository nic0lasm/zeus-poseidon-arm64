# Fichiers du jeu original : propriété de l'éditeur, jamais versionnés
/original/*
!/original/.gitkeep
/assets-extracted/
# Bases Ghidra (volumineuses, binaires) ; on versionne les exports/notes
/analysis/ghidra/*
!/analysis/ghidra/.gitkeep
/build/
# Fichiers écrits par le jeu émulé (sauvegardes, réglages)
/run/
/*.zip
.DS_Store
*.o
*.dSYM/
__pycache__/
